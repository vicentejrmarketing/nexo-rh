# Copie para .env e preencha. Nunca faça commit do .env.

# Banco principal (Supabase → Project Settings → Database → Connection string).
# Na Vercel use a conexão "Transaction pooler" (porta 6543) com ?pgbouncer=true.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres"

# Banco separado só para os testes automatizados (o nome precisa terminar em _test).
TEST_DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/nexo_rh_test"

# Conexões simultâneas por instância (padrão 5).
DATABASE_POOL_MAX=5

# Primeiro administrador — usado pelo seed apenas quando ainda não existe nenhum usuário.
# A senha é temporária: o sistema obriga a troca no primeiro acesso.
ADMIN_EMAIL="voce@empresa.com.br"
ADMIN_NAME="Seu Nome"
ADMIN_INITIAL_PASSWORD="defina-uma-senha-temporaria-forte"
